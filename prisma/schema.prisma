generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Farm {
  id          String    @id @default(uuid())
  name        String
  ownerName   String
  paddocks    Paddock[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Paddock {
  id           String   @id @default(uuid())
  name         String
  areaHectares Float
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}